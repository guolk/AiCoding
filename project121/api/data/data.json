  "listeningNotes": [
    {
      "id": "note-1",
      "workId": "work-1",
      "versionId": "version-1",
      "listenDate": "2024-05-15",
      "movementNotes": [
        {
          "movementNumber": 1,
          "title": "Allegro ma non troppo, un poco maestoso",
          "impression": "开篇极具气势，乐团的张力令人震撼。Furtwängler 对节奏的把握极为精妙。"
        },
        {
          "movementNumber": 2,
          "title": "Molto vivace",
          "impression": "诙谐曲充满活力，与前后乐章形成完美对比。"
        },
        {
          "movementNumber": 3,
          "title": "Adagio molto e cantabile",
          "impression": "极其动人的慢板，弦乐声部的歌唱性令人动容。"
        },
        {
          "movementNumber": 4,
          "title": "Presto",
          "impression": "终乐章的\"欢乐颂\"激动人心，合唱团和独唱家的表现完美。"
        }
      ],
      "emotionalJourney": "从庄严的开场，经过激烈的动荡，最终抵达人性的升华。",
      "highlightMoments": [
        {
          "timestamp": "58:30",
          "description": "欢乐颂主题首次完整呈现"
        },
        {
          "timestamp": "62:15",
          "description": "四重唱开始的瞬间"
        }
      ],
      "structureAnalysis": "四个乐章的结构极为经典，末乐章的变奏结构展现了贝多芬的天才构思。",
      "historicalNotes": "这部作品在贝多芬失聪的情况下完成，首演时作曲家已完全听不到。",
      "overallImpression": "真正的经典，每次聆听都能发现新的细节。",
      "createdAt": "2026-05-30T14:26:00.732Z"
    },
    {
      "id": "note-2",
      "workId": "work-2",
      "versionId": "version-3",
      "listenDate": "2024-04-20",
      "movementNotes": [
        {
          "movementNumber": 2,
          "title": "Andante",
          "impression": "第二乐章的旋律太动人了，莫扎特的天才在此展现无遗。"
        }
      ],
      "emotionalJourney": "从光明的C大调，经过深情的F大调，最终回归欢乐。",
      "highlightMoments": [
        {
          "timestamp": "6:45",
          "description": "第二乐章钢琴独奏的主题进入"
        }
      ],
      "overallImpression": "莫扎特的钢琴协奏曲中最优雅的作品之一。",
      "createdAt": "2026-05-30T14:26:00.732Z"
    }
